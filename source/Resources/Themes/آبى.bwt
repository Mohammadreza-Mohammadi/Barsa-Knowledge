<?xml version="1.0" encoding="utf-8"?>
<styleLibrary office2007ColorScheme="Blue" office2007CustomBlendColor="">
  <annotation>
    <author />
    <copyright />
    <description>XaraName=Blue;</description>
    <version />
    <permittedUsage />
    <lastModified>2010-03-09T09:17:15</lastModified>
  </annotation>
  <styleSets defaultStyleSet="Default">
    <styleSet name="Default" buttonStyle="Office2007RibbonButton" headerStyle="WindowsVista" viewStyle="Office2007" useOsThemes="False" useFlatMode="True">
      <checkBoxGlyphInfo>Office2007CheckBoxGlyphInfo</checkBoxGlyphInfo>
      <radioButtonGlyphInfo>Office2007RadioButtonGlyphInfo</radioButtonGlyphInfo>
      <componentStyles>
        <componentStyle name="BarsaCalculator" buttonStyle="Office2007RibbonButton" useOsThemes="False" />
        <componentStyle name="BarsaExpandableGroupBox" buttonStyle="WindowsVistaButton">
          <properties>
            <property name="ExpansionIndicator" colorCategory="{Default}">Far</property>
            <property name="ExpansionIndicatorCollapsed" colorCategory="{Default}"></property>
            <property name="ExpansionIndicatorExpanded" colorCategory="{Default}"></property>
            <property name="ViewStyle" colorCategory="{Default}">VisualStudio2005</property>
          </properties>
        </componentStyle>
        <componentStyle name="BarsaGroupBox">
          <properties>
            <property name="HeaderPosition" colorCategory="{Default}">TopOnBorder</property>
            <property name="ViewStyle" colorCategory="{Default}">Office2003</property>
          </properties>
        </componentStyle>
        <componentStyle name="BarsaTree">
          <properties>
            <property name="DisplayStyle" colorCategory="{Default}">WindowsVista</property>
          </properties>
        </componentStyle>
        <componentStyle name="Inbox Form">
          <properties>
            <property name="BackColor" colorCategory="{Default}">249, 252, 255</property>
          </properties>
        </componentStyle>
        <componentStyle name="Inbox UserControl">
          <properties>
            <property name="BackColor" colorCategory="{Default}">249, 252, 255</property>
          </properties>
        </componentStyle>
      </componentStyles>
      <styles>
        <style role="BarsaButtonDefault">
          <states>
            <state name="Normal" borderColor3DBase="Office2007.ButtonCheckedBorderGradientLight" />
          </states>
        </style>
        <style role="BarsaCalculator" borderStyle="None">
          <states>
            <state name="Normal" borderColor="Office2007.EditorBorder" />
          </states>
        </style>
        <style role="BarsaCalculatorButtonBase" buttonStyle="Office2007RibbonButton">
          <states>
            <state name="Normal" borderColor="Office2007.ButtonBorderColor" borderAlpha="UseAlphaLevel" />
            <state name="HotTracked" borderColor="Office2007.ButtonHighlightBorderGradientDark" borderColor2="Office2007.ButtonHighlightBorderGradientLight" />
            <state name="Pressed" borderColor="Office2007.ButtonPressedGradientDark" borderColor2="Office2007.ButtonPressedGradientLight" />
          </states>
        </style>
        <style role="BarsaCalculatorEditArea">
          <states>
            <state name="Normal" backColor="Office2007.EditorBackColor" borderColor="Office2007.EditorBorder" backGradientStyle="None" backHatchStyle="None" />
          </states>
        </style>
        <style role="BarsaCheckEditor">
          <states>
            <state name="Normal" backColorAlpha="Transparent" />
          </states>
        </style>
        <style role="BarsaGroupBox">
          <states>
            <state name="Normal" borderColor="175, 205, 242" />
          </states>
        </style>
        <style role="BarsaGroupBoxContentArea">
          <states>
            <state name="Normal" backColor="227, 239, 255" borderColor="175, 205, 242" backGradientStyle="None" />
          </states>
        </style>
        <style role="BarsaGroupBoxHeader" borderStyle="Solid" />
        <style role="BarsaGroupBoxHeaderHorizontalTop">
          <states>
            <state name="Normal" foreColor="245, 248, 255" borderColor="Transparent" imageBackgroundStyle="Stretched" borderAlpha="Transparent" imageBackgroundStretchMargins="5, 4, 5, 2">
              <imageBackground></imageBackground>
            </state>
          </states>
        </style>
        <style role="BarsaLabel">
          <states>
            <state name="Normal" backColor="Transparent" backGradientStyle="None" backHatchStyle="None" />
          </states>
        </style>
        <style role="BarsaOptionSet">
          <states>
            <state name="Normal" backColorAlpha="Transparent" />
          </states>
        </style>
        <style role="BarsaPanel">
          <states>
            <state name="Normal" backColor="227, 239, 255" borderColor="175, 205, 242" backGradientStyle="None" backHatchStyle="None" />
          </states>
        </style>
        <style role="BarsaPanelBox">
          <states>
            <state name="Normal" backColor="227, 239, 255" borderColor="175, 205, 242" backGradientStyle="None" backHatchStyle="None" />
            <state name="FixedColumn" imageBackgroundStyle="Centered" backGradientAlignment="Container" />
          </states>
        </style>
        <style role="BarsaPictureBox" borderStyle="TwoColor">
          <states>
            <state name="Normal" borderColor="Office2007.DropdownResizeGrabHandleDarkSquare" borderColor2="Office2007.EditorBackColor" />
          </states>
        </style>
        <style role="BarsaProgressBar" borderStyle="Rounded1">
          <states>
            <state name="Normal" backColor="Office2007.QuickCustomizeOpenFloating" borderColor="176, 207, 247" backColor2="Office2007.RibbonCaptionAreaBottomInnerBorder" backGradientStyle="VerticalBump" />
          </states>
        </style>
        <style role="Base">
          <states>
            <state name="Normal" fontName="Tahoma" />
          </states>
        </style>
        <style role="Button">
          <states>
            <state name="Normal" backColorDisabled="229, 229, 229" backColorDisabled2="229, 229, 229" />
          </states>
        </style>
        <style role="DockAreaSplitterBarVertical">
          <states>
            <state name="Normal" backGradientStyle="Horizontal" />
          </states>
        </style>
        <style role="DropDownControlArea">
          <states>
            <state name="Normal" borderColor="136, 158, 176" />
          </states>
        </style>
        <style role="EditorButton">
          <states>
            <state name="Normal" backColorAlpha="UseAlphaLevel" backColorDisabled="Transparent" />
            <state name="HotTracked" backColorDisabled="Transparent" backColorDisabled2="Transparent" />
            <state name="Pressed" backColorDisabled="Transparent" />
          </states>
        </style>
        <style role="EditorControl">
          <states>
            <state name="Normal" backColor="Window" backGradientStyle="None" backHatchStyle="None" />
          </states>
        </style>
        <style role="FlyoutPaneSplitterBarVertical">
          <states>
            <state name="Normal" backGradientStyle="Horizontal" />
          </states>
        </style>
        <style role="GridCaption">
          <states>
            <state name="Normal" backColor="209, 228, 247" backColor2="Office2007.MenuIconAreaExpandedGradientDark" backGradientStyle="GlassTop50Bright" />
          </states>
        </style>
        <style role="GridColumnHeader">
          <states>
            <state name="Normal" backColor="200, 223, 246" borderColor="111, 161, 200" backColor2="190, 212, 233" />
            <state name="HotTracked" backColor="Office2007.HighlightPressedGradientDark" borderColor="200, 248, 148, 60" backColor2="226, 135, 54" />
          </states>
        </style>
        <style role="GridControlArea">
          <states>
            <state name="Normal" borderColor="165, 191, 213" />
          </states>
        </style>
        <style role="GridGroupByBox">
          <states>
            <state name="Normal" imageBackgroundStyle="Stretched" imageBackgroundStretchMargins="1, 1, 1, 1">
              <imageBackground></imageBackground>
            </state>
          </states>
        </style>
        <style role="GridGroupByBoxPrompt">
          <states>
            <state name="Normal" foreColor="253, 0, 21, 110" imageBackgroundOrigin="Client" backColorAlpha="Transparent">
              <imageBackground></imageBackground>
            </state>
          </states>
        </style>
        <style role="GridRow">
          <states>
            <state name="Normal" borderColor="162, 202, 234" />
          </states>
        </style>
        <style role="GridRowScrollRegionSplitBox">
          <states>
            <state name="Normal" backColor="Office2007.MenuExpandButtonGradientLight" backGradientStyle="None" backHatchStyle="None" />
          </states>
        </style>
        <style role="GridRowSelector">
          <states>
            <state name="Normal" backColor="200, 223, 246" borderColor="111, 161, 200" backGradientStyle="None" backHatchStyle="None" />
          </states>
        </style>
        <style role="GroupPaneSplitterBarVertical">
          <states>
            <state name="Normal" backGradientStyle="Horizontal" />
          </states>
        </style>
        <style role="MenuCheckMark">
          <states>
            <state name="Checked" backColor="Office2007.HighlightMouseDownGradientLight" backGradientStyle="None" backHatchStyle="None" />
          </states>
        </style>
        <style role="NavigationBarControlArea">
          <states>
            <state name="Normal" borderColor="Office2007.ExplorerBarBorderColor" borderColor2="Transparent" />
          </states>
        </style>
        <style role="NavigationBarEditModeClickArea">
          <states>
            <state name="Normal" borderAlpha="Transparent" />
          </states>
        </style>
        <style role="NavigatorGroupHeader" buttonStyle="ButtonSoft" />
        <style role="ProgressBarFill">
          <states>
            <state name="Normal" backColor="255, 221, 131" backColor2="Office2007.PopupGalleryItemPressedGradientDark" backGradientStyle="Vertical" />
          </states>
        </style>
        <style role="ScrollBarArrow">
          <states>
            <state name="Pressed">
              <resources>
                <name>ScrollBar_Btn_Pressed</name>
              </resources>
            </state>
          </states>
        </style>
        <style role="ScrollBarThumb">
          <states>
            <state name="HotTracked">
              <resources>
                <name>ScrollBar_Btn_Hot</name>
              </resources>
            </state>
            <state name="Pressed">
              <resources>
                <name>ScrollBar_Btn_Pressed</name>
              </resources>
            </state>
          </states>
        </style>
        <style role="SplitterBar">
          <states>
            <state name="Normal" backColor="Office2007.OutlookNavPaneSplitterGradientLight" backColor2="Office2007.OutlookNavPaneSplitterDarkSquare" backGradientStyle="Vertical" />
          </states>
        </style>
        <style role="TabClientArea">
          <states>
            <state name="Normal" backColor="227, 239, 255" backGradientStyle="None" backHatchStyle="None" />
          </states>
        </style>
        <style role="TabControlTabListButton">
          <states>
            <state name="Normal" backColorAlpha="Transparent" borderAlpha="UseAlphaLevel" />
            <state name="HotTracked" backColorAlpha="UseAlphaLevel" />
            <state name="Pressed" backColorAlpha="UseAlphaLevel" />
          </states>
        </style>
        <style role="ThumbViewColumnHeader">
          <states>
            <state name="Normal" backColor="Office2007.FloatingControlContainerToolbar" borderColor="Office2007.FloatingToolbarCaption" backGradientStyle="None" backHatchStyle="None" />
          </states>
        </style>
        <style role="ThumbViewControlArea">
          <states>
            <state name="Normal" borderColor="163, 192, 225" />
          </states>
        </style>
        <style role="ThumbViewItem">
          <states>
            <state name="Selected" backColor="Office2007.GrabHandleDarkSquare" backGradientStyle="None" backHatchStyle="None" />
          </states>
        </style>
        <style role="ToolbarDockAreaTop">
          <states>
            <state name="Normal">
              <resources>
                <name>DockArea</name>
              </resources>
            </state>
          </states>
        </style>
        <style role="ToolbarItemQuickCustomize">
          <states>
            <state name="Normal" foreColor="Office2007.GrabHandleDarkSquare" />
          </states>
        </style>
        <style role="TreeControlArea">
          <states>
            <state name="Normal" borderColor="Office2007.EditorBorder" />
          </states>
        </style>
        <style role="TreeNode">
          <states>
            <state name="Normal" borderColor="Transparent" />
            <state name="Selected" borderAlpha="UseAlphaLevel">
              <resources>
                <name>TreeNode_Selected</name>
              </resources>
            </state>
            <state name="HotTracked">
              <resources>
                <name>TreeNode_HotTracked</name>
              </resources>
            </state>
            <state name="Active" borderColor="Office2007.ApplicationMenuBorderColor" />
          </states>
        </style>
        <style role="ValueList">
          <states>
            <state name="Normal" borderColor="Office2007.ButtonBorderColor" />
          </states>
        </style>
      </styles>
      <sharedObjects>
        <sharedObject name="ProgressBarEditor">
          <properties>
            <property name="ProgressBarStyle" colorCategory="{Default}">Office2007Continuous</property>
          </properties>
        </sharedObject>
      </sharedObjects>
