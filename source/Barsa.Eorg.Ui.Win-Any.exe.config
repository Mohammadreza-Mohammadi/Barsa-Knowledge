<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="log4net" type="System.Configuration.IgnoreSectionHandler" />
    <sectionGroup name="userSettings" type="System.Configuration.UserSettingsGroup, System, Version=2.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089">
      <section name="WindowsApplication1.Properties.Settings" type="System.Configuration.ClientSettingsSection, System, Version=2.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" allowExeDefinition="MachineToLocalUser" requirePermission="false" />
    </sectionGroup>
  </configSections>
  <appSettings>
    <!-- Default Application Config Section-->
    <add key="DBProvider" value="System.Data.SqlClient" />
    <add key="DBConnectionString" value="Sql:172.16.176.88/sqlcore,Db=nid_NewWebDevelop % V1 % DD-BA-CF-47-99-F4-91-48-86-2D-CA-E6-A7-0F-D9-F8-69-14-86-B3-16-76-FD-6D-3E-67-EC-FC-25-C1-D5-12-A1-99-C9-CD-AD-4F-48-82-9B-BC-07-3D-5D-CC-54-B1-90-4C-E5-5F-94-0F-34-21-15-A7-D0-8E-C3-65-B5-E0-7D-A5-72-DF-8F-56-23-8A-A3-B3-D0-98-B0-D2-62-74-4F-FA-45-55-C3-B8-3A-5E-21-49-7C-56-73-F8-7D-4E-DD-B8-D7-9E-90-AE-0D-4E-07-70-F9-4D-59-FF-74-76-4B-F0-B9-CD-91-86-A3-86-E4-96-8A-D6-54-D8-87-8E-BA-85-A7-98-AC-1B-C3-91-DE-D1-C1-16-D7-D4-ED-27" />
    <add key="RemotingUsage" value="None" />
    <add key="RemotingUrl" value="tcp://192.168.1.21:14001/BarsaSpl" />
    <add key="MaxInstanceCount" value="1" />
    <add key="Color" value="1" />
    <!--<add key="ShouldBeRunUnderDotNet2" value="true" />-->
    <!--<add key="CompilerVersion" value="v2.0" />-->
    <!--<add key="DefaultCodeAssemblyList" value="" />-->
    <!--<add key="MetaCache" value="false" />-->
    <!--<add key="CacheEnabled" value="true" />-->
    <!--<add key="ClearOldVersionFilesEnabled" value="false" />-->
    <!--<add key="EnableFunctionalTest" value="true" />-->
    <!--<add key="RemotingCompress" value="0" />-->
    <!--<add key="SingleSystemName" value="SystemTitle" />-->
    <!--<add key="AdditionalDllToLoad" value="" /> -->
    <!--<add key="NewNumericEditor" value="true" />-->
    <add key="ClearOldVersionFilesEnabled" value="false" />
  </appSettings>
  <log4net>
    <!-- Define some output appenders -->
    <appender name="RollingLogFileAppender" type="log4net.Appender.RollingFileAppender">
      <level value="ALL" />
      <param name="File" value="barsa-log.txt" />
      <param name="AppendToFile" value="true" />
      <param name="MaxSizeRollBackups" value="10" />
      <param name="MaximumFileSize" value="100KB" />
      <param name="RollingStyle" value="Size" />
      <param name="StaticLogFileName" value="true" />
      <layout type="log4net.Layout.PatternLayout">
        <param name="Header" value="LogType , Title , Time , Description , SessionId\r\n" />
        <param name="Footer" value="[Footer]\r\n" />
        <!--
				<param name="ConversionPattern" value="%d [%t] %-5p %c [%x] - %m%n" />
				-->
        <param name="ConversionPattern" value="%m%n" />
      </layout>
    </appender>
    <root>
      <level value="ALL" />
      <appender-ref ref="RollingLogFileAppender" />
    </root>
  </log4net>
  <system.runtime.remoting>
    <customErrors mode="Off" />
    <application name="BarsaSpl">
      <channels>
        <channel ref="tcp" port="0">
          <clientProviders>
            <provider type="Barsa.Spl.Remoting.Sinks.CustomClientSinkProvider, Barsa.Spl.Remoting.Sinks" customSinkType="Barsa.Spl.Remoting.Sinks.ClientBeforeFormatterSink, Barsa.Spl.Remoting.Sinks" />
            <formatter ref="binary" typeFilterLevel="Full" />
            <provider type="Barsa.Spl.Remoting.Sinks.CustomClientSinkProvider, Barsa.Spl.Remoting.Sinks" customSinkType="Barsa.Spl.Remoting.Sinks.ClientAfterFormatterSink, Barsa.Spl.Remoting.Sinks" />
          </clientProviders>
        </channel>
      </channels>
      <lifetime leaseTime="0M" sponsorshipTimeOut="1S" renewOnCallTime="1S" leaseManagerPollTime="1S" />
    </application>
  </system.runtime.remoting>
  <startup useLegacyV2RuntimeActivationPolicy="true">
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.0" />
  </startup>
  <runtime>
    <gcAllowVeryLargeObjects enabled="true" />
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="Newtonsoft.Json" publicKeyToken="30ad4fe6b2a6aeed" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-13.0.0.0" newVersion="13.0.0.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
</configuration>