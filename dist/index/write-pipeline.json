    {
      "step": "AiSocWriteProjection.ValidateSoc",
      "what": "separation-of-concerns check on the payload"
    },
    {
      "step": "AiChangePlanner.PrepareV15ChangeForPlanInspection",
      "what": "normalize the command so it can be inspected without mutating"
    },
    {
      "step": "AiProviderPayloadPolicy.Prepare",
      "what": "apply the provider's payload policy"
    },
    {
      "step": "AiChangePlanner.ProjectCreateForStructuralValidation",
      "what": "project a create far enough to validate its structure"
    },
    {
      "step": "IAiChangeProvider.Validate",
      "what": "the provider's own validation -> AiProviderValidation"
    },
    {
      "step": "AiChangePlanner.ValidatePortableTransport",
      "what": "asset and portability checks"
    },
    {
      "step": "AiInfrastructureCapabilityResolver.ResolveForPlan",
      "what": "bind required infrastructure capabilities, or fail with infrastructureBindingUnresolved"
    },
    {
      "step": "IAiChangeProvider.BuildFingerprint",
      "what": "record what the target looked like at plan time"
    },
    {
      "step": "AiChangePlanner.CollectTempReferences",
      "what": "derive Dependencies and RequiresApplyValidation"
    },
    {
      "step": "AiChangePlanner.PlanDbNameRemaps",
      "what": "plan physical column renames"
    },
    {
      "step": "AiChangePlanner.ApplyFieldSiblingReconstructionOrder",
      "what": "order sibling fields"
    },
    {
      "step": "AiChangePlanner.SortByDependencies",
      "what": "topologically order the commands"
    },
    {
      "step": "AiChangePlanner.UpdateSummary",
      "what": "fill AiPlanSummary"
    }
