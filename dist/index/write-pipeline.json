    {
      "step": "AiChangePlanner.AssignStableIds",
      "what": "give every command a stable identity"
    },
    {
      "step": "AiChangePlanner.BuildTempOwners",
      "what": "map each tempId to the command that declares it"
    },
    {
      "step": "AiProviderResolver.Resolve",
      "what": "pick the provider whose CanHandle matches objectType"
    },
    {
      "step": "AiChangePlanner.ValidateV15SemanticAuthority",
