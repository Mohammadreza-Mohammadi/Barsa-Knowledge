r message = (MO_IMessage) mo.IMessage_MetaObject;\r\n\t\t\t\tvar notificationWhatsAppSettings = (MO_WhatsappSettings) MO_WhatsappSettings.TypeDef.SelectFirstObjectBy(MO_WhatsappSettings.cf_برای_نوتیفیکشن, true, MO_WhatsappSettings.cf_غیرفعال, false);\r\n\t\t\t\tif (notificationWhatsAppSettings == null)\r\n\t\t\t\t\treturn ;\r\n\r\n\t\t\t\tvar client = (MO_WhatsAppClient) notificationWhatsAppSettings.کلاینت_واتس_اپ_MetaObject;\r\n\t\t\t\tvar date = message.Object.GetFieldCaption(\"زمان ایجاد\");\r\n\t\t\t\tvar content = message.Object.GetFieldCaption(\"محتوا\");\r\n\t\t\t\tvar user = Barsa.Spl.BasicInfo.User.LoadById(message.کاربر_ایجاد_کننده);\r\n\t\t\t\tvar recieverUser = message.کاربر_گیرنده;\r\n\t\t\t\tvar repNumber = Report.LoadByName(\"_Barsa_WhatsappPhoneNumber\");\r\n\t\t\t\tif (repNumber == null)\r\n\t\t\t\t\treturn ;\r\n\t\t\t\trepNumber.ReportDataObject.SetAskParameterValues(recieverUser);\r\n\t\t\t\tvar whatsappGirandeh = repNumber.ExecuteFirst();\r\n\t\t\t\tif (whatsappGirandeh == null)\r\n\t\t\t\t\treturn ;\r\n\t\t\t\tvar messageDataToSend = new MessageDataToSend()\r\n\t\t\t\t{\r\n\t\t\t\t\tContent = string.Format(\"{0}{1}{2}{3}{4}{5}{6}{7}{8}/#/login?notificationTag={9}&action=show\",\r\n\t\t\t\t\t\tmo.Title, System.Environment.NewLine,\r\n\t\t\t\t\t\tdate, Environment.NewLine,\r\n\t\t\t\t\t\tcontent.Replace(\"&lt;br&gt;\", string.Empty), Environment.NewLine,\r\n\t\t\t\t\t\tuser.DisplayName, Environment.NewLine,\r\n\t\t\t\t\t\tnotificationWhatsAppSettings.آدرس_سایت,\r\n\t\t\t\t\t\tmo.Tag\r\n\t\t\t\t\t\t),\r\n\t\t\t\t\tToContacts = whatsappGirandeh.GetFieldValue<string>(\"شماره واتس اپ\")\r\n\t\t\t\t};\r\n\t\t\t\tSendCommandToNodeServer(\"Send\", client.ClientId, messageDataToSend);\r\n\r\n\t\t\t}\r\n\t\t}\r\n\t\tpublic static void BarsaTestSendFileToWhatsapp(MetaObject mo)\r\n\t\t{\r\n\t\t\tMO_تست_ارسال_فایل testFile = mo;\r\n\t\t\tif (testFile.فایل == null)\r\n\t\t\t\treturn ;\r\n\t\t\tvar x = ((Barsa.SharedObjects.FileAttachmentList) testFile.فایل)[0];\r\n\t\t\tvar mimeType = Barsa.Meta.Extra.MimeTypeHelper0.GetMimeType(x.Content.Bytes);\r\n\t\t\tvar mm1 = string.Format(\"{0}/{1})\", mimeType.PrimaryType, mimeType.SubType);\r\n\t\t\tvar mm2 = Convert.ToBase64String(x.Content.Bytes);\r\n\t\t\tBarsaWhatsappSendFile(x.NameAndExtension, mm2, mm1, testFile.متن_ارسالی_با_فایل, testFile.گیرندگان);\r\n\t\t}\r\n\t\tpublic static void BarsaWhatsappSendFile(string filename, string base64File, string mimeType, string caption, string toContacts)\r\n\t\t{\r\n\t\t\t// tocontacts=091233,0922333,095454\r\n\t\t\tvar notificationWhatsAppSettings = (MO_WhatsappSettings) MO_WhatsappSettings.TypeDef.SelectFirstObjectBy(MO_WhatsappSettings.cf_برای_نوتیفیکشن, true, MO_WhatsappSettings.cf_غیرفعال, false);\r\n\t\t\tif (notificationWhatsAppSettings == null)\r\n\t\t\t\treturn ;\r\n\r\n\t\t\tvar client = (MO_WhatsAppClient) notificationWhatsAppSettings.کلاینت_واتس_اپ_MetaObject;\r\n\r\n\t\t\tvar messageFileToSend = new MessageFileToSend()\r\n\t\t\t{\r\n\t\t\t\tFilename = filename,\r\n\t\t\t\tBase64File = base64File,\r\n\t\t\t\tMimeType = mimeType,\r\n\t\t\t\tCaption = caption,\r\n\t\t\t\tToContacts = toContacts\r\n\t\t\t};\r\n\t\t\tSendCommandToNodeServer(\"SendFile\", client.ClientId, messageFileToSend);\r\n\t\t}\r\n\t\tpublic static void LoadGroups(MetaObject mo)\r\n\t\t{\r\n\t\t\tMO_WhatsAppClient client = mo;\r\n\t\t\tSendCommandToNodeServer(\"loadgroups\", client.ClientId);\r\n\t\t}\r\n\t\tpublic static void Initialize(MetaObject mo)\r\n\t\t{\r\n\t\t\tMO_WhatsAppClient client = mo;\r\n\t\t\tSendCommandToNodeServer(\"initialize\", client.ClientId);\r\n\t\t}\r\n\t\tpublic static void Logout(MetaObject mo)\r\n\t\t{\r\n\t\t\tMO_WhatsAppClient client = mo;\r\n\t\t\tSendCommandToNodeServer(\"logout\", client.ClientId);\r\n\t\t}\r\n\t\tpublic static void Destroy(MetaObject mo)\r\n\t\t{\r\n\t\t\tMO_WhatsAppClient client = mo;\r\n\t\t\tSendCommandToNodeServer(\"destroy\", client.ClientId);\r\n\t\t}\r\n\r\n\t\tpublic static void CheckWhatsAppServerOnline(MetaObject mo)\r\n\t\t{\r\n\t\t\tvar isOnline = IsNodeServerOnline();\r\n\t\t\tif (!isOnline)\r\n\t\t\t{\r\n\t\t\t\tthrow new MetaException(NODE_SERVER_UNAVAILABLE);\r\n\t\t\t}\r\n\t\t}\r\n\t\tprivate static bool IsNodeServerOnline()\r\n\t\t{\r\n\t\t\tvar isOnline = false;\r\n\t\t\tusing (var httpClient = new HttpClient())\r\n\t\t\t{\r\n\t\t\t\thttpClient.Timeout = TimeSpan.FromSeconds(10);\r\n\r\n\t\t\t\thttpClient.BaseAddress = new Uri(NodeServerAddress);\r\n\t\t\t\ttry\r\n\t\t\t\t{\r\n\t\t\t\t\tvar response = httpClient.GetAsync(\"/\").Result;\r\n\t\t\t\t\tresponse.EnsureSuccessStatusCode();\r\n\t\t\t\t\tisOnline = false;\r\n\t\t\t\t}\r\n\t\t\t\tcatch (HttpRequestException httpEx)\r\n\t\t\t\t{\r\n\r\n\t\t\t\t\tSplLogger.WriteError(httpEx, \"Node server is offline.\");\r\n\r\n\t\t\t\t}\r\n\t\t\t\tcatch (Exception err)\r\n\t\t\t\t{\r\n\t\t\t\t\tSplLogger.WriteError(err, \"error in IsNodeServerOnline.\");\r\n\r\n\t\t\t\t}\r\n\t\t\t};\r\n\t\t\treturn isOnline;\r\n\t\t}\r\n\t\tpublic static async Task SendCommandToNodeServer(string commandName, string clientId, object data = null)\r\n\t\t{\r\n\t\t\tif (!isSetNodeServer)\r\n\t\t\t{\r\n\t\t\t\tisSetNodeServer = true;\r\n\t\t\t\tvar x = (MO_WhatsappSettings) MO_WhatsappSettings.TypeDef.SelectFirstObjectBy(MO_WhatsappSettings.cf_برای_نوتیفیکشن, true);\r\n\t\t\t\tif (x == null)\r\n\t\t\t\t\tNodeServerAddress = string.Empty;\r\n\t\t\t\telse\r\n\t\t\t\t\tNodeServerAddress = x.آدرس_وب_سرویس_واتس_اپ;\r\n\t\t\t}\r\n\t\t\tif (string.IsNullOrEmpty(NodeServerAddress))\r\n\t\t\t\treturn ;\r\n\t\t\tusing (var httpClient = new HttpClient())\r\n\t\t\t{\r\n\t\t\t\tvar jsonContent = JsonConvert.SerializeObject(new ClientInfo()\r\n\t\t\t\t\t{\r\n\t\t\t\t\t\tClientId = clientId,\r\n\t\t\t\t\t\tData = data\r\n\t\t\t\t\t}, new JsonSerializerSettings()\r\n\t\t\t\t\t{\r\n\t\t\t\t\t\tContractResolver = new CamelCasePropertyNamesContractResolver()\r\n\t\t\t\t\t});\r\n\t\t\t\thttpClient.Timeout = TimeSpan.FromSeconds(5);\r\n\t\t\t\thttpClient.BaseAddress = new Uri(NodeServerAddress);\r\n\t\t\t\tvar content = new StringContent(jsonContent, Encoding.UTF8, \"application/json\");\r\n\t\t\t\tvar response = await httpClient.PostAsync(string.Format(\"{0}\", commandName), content);\r\n\t\t\t\tif (response.StatusCode == System.Net.HttpStatusCode.ServiceUnavailable)\r\n\t\t\t\t{\r\n\t\t\t\t\tthrow new MetaException(NODE_SERVER_UNAVAILABLE);\r\n\t\t\t\t}\r\n\t\t\t};\r\n\t\t}\r\n\t\tpublic static async Task SendInitalizAllClientToServer(IEnumerable<string> clientIds)\r\n\t\t{\r\n\t\t\tusing (var httpClient = new HttpClient())\r\n\t\t\t{\r\n\t\t\t\tvar jsonContent = JsonConvert.SerializeObject(clientIds, new JsonSerializerSettings()\r\n\t\t\t\t\t{\r\n\t\t\t\t\t\tContractResolver = new CamelCasePropertyNamesContractResolver()\r\n\t\t\t\t\t});\r\n\t\t\t\thttpClient.BaseAddress = new Uri(NodeServerAddress);\r\n\t\t\t\tvar content = new StringContent(jsonContent, Encoding.UTF8, \"application/json\");\r\n\t\t\t\tvar t = httpClient.PostAsync(\"initalizeAllClient\", content).Result;\r\n\t\t\t};\r\n\t\t}\r\n\r\n\t\tpublic static void OnWhatsAppEvents(string eventName, string data, string clientId)\r\n\t\t{\r\n\t\t\tMO_WhatsAppClient client = MO_WhatsAppClient.TypeDef.SelectFirstObjectBy(\"ClientId\", clientId);\r\n\t\t\tif (client == null)\r\n\t\t\t\tthrow new MetaException(string.Format(\"WhatsApp Client:{0} Not Found.\", clientId));\r\n\t\t\tswitch (eventName)\r\n\t\t\t{\r\n\t\t\t\tcase \"start\":\r\n\t\t\t\t\tOnServerStart();\r\n\t\t\t\t\tbreak;\r\n\t\t\t\tcase \"initialized\":\r\n\t\t\t\t\tOnClientInitialized(client);\r\n\t\t\t\t\tbreak;\r\n\t\t\t\tcase \"qr\":\r\n\t\t\t\t\tOnClientQr(client, data);\r\n\t\t\t\t\tbreak;\r\n\t\t\t\tcase \"authenticated\":\r\n\t\t\t\t\tOnClientAuthenticated(client);\r\n\t\t\t\t\tbreak;\r\n\t\t\t\tcase \"ready\":\r\n\t\t\t\t\tOnClientIsReady(client);\r\n\t\t\t\t\tbreak;\r\n\t\t\t\tcase \"disconnected\":\r\n\t\t\t\t\tOnClientDisconnected(client);\r\n\t\t\t\t\tbreak;\r\n\t\t\t\tcase \"message\":\r\n\t\t\t\t\tOnClientMessageArrived(client, data);\r\n\t\t\t\t\tbreak;\r\n\t\t\t\tcase \"groupsLoaded\":\r\n\t\t\t\t\tOnGroupsLoaded(client, data);\r\n\t\t\t\t\tbreak;\r\n\t\t\t}\r\n\t\t}\r\n\r\n\t\tprivate static void OnServerStart()\r\n\t\t{\r\n\t\t\tvar clients = MO_WhatsAppClient.TypeDef.SelectObjectListBy(MO_WhatsAppClient.cf_Disabled, false);\r\n\r\n\t\t\tList<string> clientIds = new List<string>();\r\n\t\t\tforeach (MetaObject mo in clients)\r\n\t\t\t{\r\n\t\t\t\tMO_WhatsAppClient client = mo;\r\n\t\t\t\tclientIds.Add(client.ClientId);\r\n\t\t\t}\r\n\t\t\tSendInitalizAllClientToServer(clientIds);\r\n\t\t}\r\n\t\tprivate static void OnGroupsLoaded(MO_WhatsAppClient client, string data)\r\n\t\t{\r\n\t\t\tvar groups = JsonConvert.DeserializeObject<IList<GroupChat>>(data);\r\n\t\t\tvar x = client.گروهای_شماره;\r\n\t\t\tx.DeleteAllFromDb();\r\n\t\t\tx.AcceptChanges();\r\n\t\t\tMetaObjectList molist = new MetaObjectList();\r\n\t\t\tforeach (var groupW in groups)\r\n\t\t\t{\r\n\t\t\t\tmolist.Add(new MO_WhatsappGroup()\r\n\t\t\t\t\t{\r\n\t\t\t\t\t\tاعضا = groupW.Participants,\r\n\t\t\t\t\tآیدی_گروه = groupW.SerializedId,\r\n\t\t\t\t\tتاریخ_ایجاد = groupW.CreatedAt,\r\n\t\t\t\t\tسرور = groupW.Server,\r\n\t\t\t\t\tتوضیحات_گروه = groupW.Description,\r\n\t\t\t\t\tنام = groupW.User\r\n\t\t\t\t\t});\r\n\t\t\t}\r\n\t\t\tclient.گروهای_شماره.Add(molist);\r\n\t\t\tclient.CRUD();\r\n\t\t}\r\n\t\tprivate static void OnClientMessageArrived(MO_WhatsAppClient client, string data)\r\n\t\t{\r\n\r\n\t\t}\r\n\t\tprivate static void OnClientDisconnected(MO_WhatsAppClient client)\r\n\t\t{\r\n\t\t\tResetClient(client);\r\n\t\t\tclient.Disconnected = true;\r\n\t\t\tclient.CRUD();\r\n\t\t}\r\n\t\tprivate static void OnClientIsReady(MO_WhatsAppClient client)\r\n\t\t{\r\n\t\t\tclient.IsReady = true;\r\n\t\t\tSetClientNotDiscounected(client);\r\n\t\t\tSetClientQrCode(client, string.Empty);\r\n\t\t\tclient.QR_Generated = false;\r\n\t\t\tclient.CRUD();\r\n\t\t}\r\n\t\tprivate static void OnClientAuthenticated(MO_WhatsAppClient client)\r\n\t\t{\r\n\t\t\tclient.Auth_Success = true;\r\n\t\t\tSetClientNotDiscounected(client);\r\n\t\t\tclient.Initialized = true;\r\n\t\t\tclient.CRUD();\r\n\t\t}\r\n\t\tprivate static void OnClientQr(MO_WhatsAppClient client, string qrCodeString)\r\n\t\t{\r\n\r\n\t\t\t//TODO set image qr code\t\t\t\r\n\t\t\tQRCodeGenerator qrg = new QRCodeGenerator();\r\n\t\t\tvar qrCodeData = qrg.CreateQrCode(qrCodeString, QRCodeGenerator.ECCLevel.Q);\r\n\r\n\t\t\tBase64QRCode qrCode = new Base64QRCode(qrCodeData);\r\n\t\t\tstring qrCodeImageAsBase64 = qrCode.GetGraphic(20);\r\n\r\n\t\t\tstring richText = string.Format(\"<html><body><img  width='400px' height='400px' src=data:image/png;base64,{0} /></body></html>\", qrCodeImageAsBase64);\r\n\t\t\tSetClientQrCode(client, richText);\r\n\r\n\t\t\tSetClientNotDiscounected(client);\r\n\t\t\tclient.QR_Generated = true;\r\n\t\t\tclient.CRUD();\r\n\t\t}\r\n\t\tprivate static void OnClientInitialized(MO_WhatsAppClient client)\r\n\t\t{\r\n\t\t\t//TODO set image qr code\r\n\t\t\tclient.Initialized = true;\r\n\t\t\tclient.CRUD();\r\n\t\t}\r\n\r\n\t\tprivate static void ResetClient(MO_WhatsAppClient client)\r\n\t\t{\r\n\t\t\tclient.Auth_Success = false;\r\n\t\t\tclient.Auth_Failure_Message = string.Empty;\r\n\t\t\tclient.IsReady = false;\r\n\t\t\tclient.Initialized = false;\r\n\t\t\tclient.QR_Generated = false;\r\n\t\t\tSetClientQrCode(client, string.Empty);\r\n\t\t\tclient.CRUD();\r\n\t\t}\r\n\r\n\t\tprivate static void SetClientNotDiscounected(MO_WhatsAppClient client)\r\n\t\t{\r\n\t\t\tclient.Initialized = true;\r\n\t\t\tclient.Disconnected = false;\r\n\t\t}\r\n\t\tprivate static void SetClientQrCode(MO_WhatsAppClient client, string richText)\r\n\t\t{\r\n\t\t\tRichStringInfo fdInfo = client.Object.TypeDef.GetFieldInfoByCaption<RichStringInfo>(\"QR Code\");\r\n\t\t\tfdInfo.SetRichValue(client, richText);\r\n\t\t}\r\n\t\tpublic class GroupChat\r\n\t\t{\r\n\t\t\tpublic string CreatedAt\r\n\t\t\t{\r\n\t\t\t\tget; set;\r\n\t\t\t}\r\n\t\t\tpublic string User\r\n\t\t\t{\r\n\t\t\t\tget; set;\r\n\t\t\t}\r\n\t\t\tpublic string Server\r\n\t\t\t{\r\n\t\t\t\tget; set;\r\n\t\t\t}\r\n\t\t\tpublic string SerializedId\r\n\t\t\t{\r\n\t\t\t\tget; set;\r\n\t\t\t}\r\n\t\t\tpublic string Description\r\n\t\t\t{\r\n\t\t\t\tget; set;\r\n\t\t\t}\r\n\t\t\tpublic string Participants\r\n\t\t\t{\r\n\t\t\t\tget; set;\r\n\t\t\t}\r\n\t\t}\r\n\r\n#endregion\r\n\r\n\t}\r\n\r\n}\r\n",
