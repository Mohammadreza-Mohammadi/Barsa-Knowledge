                "hasConditions": true,
                "branches": [
                  {
                    "condition": {
                      "operator": "isNull",
                      "field": "#Auth Failure Message",
                      "value": null,
                      "customCodeExecutePerRow": true
                    },
                    "actions": [
                      {
                        "type": "field",
                        "fields": [
