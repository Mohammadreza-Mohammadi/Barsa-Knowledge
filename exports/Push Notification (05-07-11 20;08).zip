                "caption": "فعال و عدم فعال Logout",
                "key": "~240094",
                "events": [
                  {
                    "type": "field",
                    "event": "valueChanged",
                    "field": "#Auth Success"
                  },
                  {
                    "type": "field",
                    "event": "valueChanged",
                    "field": "#Disconnected"
                  }
                ],
                "hasConditions": true,
                "branches": [
                  {
                    "condition": {
                      "all": [
                        {
                          "operator": "equal",
                          "field": "#Auth Success",
                          "value": "true",
                          "customCodeExecutePerRow": true
                        },
                        {
                          "operator": "equal",
                          "field": "#Disconnected",
                          "value": "false",
                          "customCodeExecutePerRow": true
                        }
                      ]
                    },
                    "actions": [
                      {
                        "type": "field",
                        "fields": [
                          "#Logout"
                        ],
                        "enabled": true
                      }
                    ]
                  },
                  {
                    "else": true,
                    "actions": [
                      {
                        "type": "reverse"
                      }
                    ]
                  }
                ]
              },
              {
