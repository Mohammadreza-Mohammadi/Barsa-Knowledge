      "كد": [
        {
          "id": 7097413820000000106,
          "$type": "Barsa.Meta.MetaCode",
          "$caption": "کد زیرسیستم(منطق کار",
          "SystemId": 7097413550000000101,
          "ParentCodeId": 0,
          "CodeLocation": 2,
          "CodeLayer": "Bl",
          "CodeLanguage": 1,
          "TargetObjectId": 7097413550000000101,
          "Code": "using System;\r\nusing System.Collections.Generic;\r\nusing System.Text;\r\nusing System.Linq;\r\nusing System.Reflection;\r\nusing System.Drawing;\r\nusing System.Threading.Tasks;\r\nusing System.Text.RegularExpressions;\r\nusing Barsa.Spl;\r\nusing Barsa.Meta;\r\n//@Newtonsoft.Json.dll\r\nusing Barsa.Workflow;\r\n\r\n\r\n//@QRCoder.dll\r\nusing QRCoder;\r\n\r\n//@@System.Net.Http.dll\r\n//@System.Web.Http.dll\r\n//@Newtonsoft.Json.dll\r\n//@Castle.Core.dll\r\n//@Winista.MimeDetect.dll\r\n\r\n//@Barsa.Web.Infrastructure.dll\r\nusing Barsa.Web.Infrastructure.Notification;\r\nusing Barsa.Web.Infrastructure.Workflow;\r\nusing Barsa.Web.Infrastructure;\r\nusing System.Net.Http;\r\nusing System.Web.Http;\r\n\r\nusing Newtonsoft.Json;\r\nusing Newtonsoft.Json.Serialization;\r\n\r\n\r\nusing PushNotification;\r\nnamespace PushNotification\r\n{\r\n\r\n\r\n\t[MetaEventClass(System_Push_Notification.cs_Caption)]\r\n\tpublic class Main\r\n\t{\r\n\r\n#region Push Notification \r\n\t\tpublic class GroupsMoList\r\n\t\t{\r\n\t\t\tpublic Barsa.Meta.Ui.ExtWeb.JDict DateGroups;\r\n\t\t\tpublic Barsa.Meta.Ui.ExtWeb.JDict SubjectGroups;\r\n\t\t\tpublic Barsa.Meta.Ui.ExtWeb.JDict PriorityGroups;\r\n\t\t}\r\n\t\tstatic string SystemPortalName = \"پورتال برسانوین‌رای\";\r\n\t\tstatic string NotificationSettingTypeDefName = \"UserNotificationSetting\";\r\n\r\n\t\t//[MetaEvent(MetaEventTopics.System_Startup)]\r\n\t\t//public static void OnMainControlConstructed(object sender, MetaEventArgs e)\r\n\t\t//{\r\n\t\t//}\r\n\r\n\t\t//[MetaEvent(\"Type Caption\", MetaEventTopics.MetaObject_BeforeUpdate)]\r\n\t\t//public static void OnType_BeforeUpdate(object sender, MetaEventArgs e)\r\n\t\t//{\r\n\t\t//}\r\n\r\n\r\n\r\n\t\t[MetaEvent(\"NotificationMessage\", MetaEventTopics.MetaObject_BeforeDelete)]\r\n\t\tpublic static void OnMetaObject_NotificationMessage_MetaObject_BeforeDelete(object sender, MetaEventArgs e)\r\n\t\t{\r\n\t\t\tMO_NotificationMessage mo = (MetaObject) sender;\r\n\t\t\ttry\r\n\t\t\t{\r\n\t\t\t\t_SendNotifcationReportRefresh(mo, \"PublishMoDelete\");\r\n\t\t\t\t_SendNotificationRefreshUnreadCount(mo);\r\n\t\t\t}catch\r\n\t\t\t{\r\n\t\t\t}\r\n\t\t}\r\n\r\n\t\t[MetaEvent(\"NotificationMessage\", MetaEventTopics.MetaObject_AfterUpdate)]\r\n\t\tpublic static void OnMetaObject_NotificationMessage_MetaObject_AfterUpdate(object sender, MetaEventArgs e)\r\n\t\t{\r\n\t\t\tMO_NotificationMessage mo = (MetaObject) sender;\r\n\t\t\t_SendNotifcationReportRefresh(mo, \"PublishMoUpdate\");\r\n\t\t\t_SendNotificationRefreshUnreadCount(mo);\r\n\t\t}\r\n\r\n\t\tpublic static void PushNotification_RemoveAll()\r\n\t\t{\r\n\t\t\t_RemoveAllNotifications(\"_RemoveAll_NotificationMessage\");\r\n\t\t}\r\n\t\tpublic static void PushNotification_RemoveAll_ExceptThisWeek()\r\n\t\t{\r\n\t\t\t_RemoveAllNotifications(\"_RemoveAll_ExceptThisWeek_NotificationMessage\");\r\n\t\t}\r\n\r\n\t\tpublic static void PushNotification_RemoveAll_ExceptToday()\r\n\t\t{\r\n\t\t\t_RemoveAllNotifications(\"_RemoveAll_ExceptToday_NotificationMessage\");\r\n\t\t}\r\n\r\n\t\tprivate static void _RemoveAllNotifications(string reportName)\r\n\t\t{\r\n\t\t\tvar rep = Report.LoadByName(reportName);\r\n\t\t\tvar molist = rep.Execute();\r\n\t\t\tif (molist.Count<1)\r\n\t\t\t\treturn ;\r\n\t\t\tnew BulkManager().BulkDelete(molist);\r\n\t\t\t_SendNotificationRefreshUnreadCountByUser(Util.CurrentUserId);\r\n\r\n\t\t\tvar report = Report.LoadByName(\"_Barsa_User_NotificationMessages\");\r\n\t\t\t_SendNotificationRefreshReportByUser(Util.CurrentUserId, report.Id);\r\n\t\t}\r\n\t\tpublic static void RemoveNotificationMessageByRelatedMoAndReciever(long relatedMo, long userId)\r\n\t\t{\r\n\t\t\tvar rep = Report.LoadByName(\"_FindNotificationByRelatedMoAndReciever\");\r\n\t\t\trep.ReportDataObject.SetAskParameterValues(relatedMo, userId);\r\n\t\t\tvar mo = rep.ExecuteFirst();\r\n\t\t\tif (mo == null)\r\n\t\t\t\treturn ;\r\n\t\t\tmo.Delete();\r\n\r\n\t\t\t_SendNotifcationReportRefresh(mo, \"PublishMoDelete\");\r\n\t\t\t_SendNotificationRefreshUnreadCount(mo);\r\n\t\t}\r\n\t\tpublic static void SetReadAllNotifications()\r\n\t\t{\r\n\t\t\tvar report = Report.LoadByName(\"_User_Unread_Notifications\");\r\n\t\t\tvar molist = report.Execute();\r\n\t\t\tforeach (MetaObject mo in molist)\r\n\t\t\t{\r\n\t\t\t\tMO_NotificationMessage message = mo;\r\n\t\t\t\tmessage.Unread = false;\r\n\t\t\t\tmessage.CRUD();\r\n\t\t\t}\r\n\t\t}\r\n\r\n\t\tpublic static void RemoveNotificationMessage(string tag)\r\n\t\t{\r\n\t\t\tvar notificationMessage = (MO_NotificationMessage) MO_NotificationMessage.TypeDef.SelectFirstObjectBy(MO_NotificationMessage.cf_Tag, tag);\r\n\t\t\tif (notificationMessage == null)\r\n\t\t\t{\r\n\t\t\t\treturn ;\r\n\t\t\t}\r\n\t\t\tnotificationMessage.Object.Delete();\r\n\t\t}\r\n\t\tpublic static void SetReadNotificationMessageByTag(string tag)\r\n\t\t{\r\n\t\t\tvar notificationMessage = (MO_NotificationMessage) MO_NotificationMessage.TypeDef.SelectFirstObjectBy(MO_NotificationMessage.cf_Tag, tag);\r\n\t\t\tif (notificationMessage == null)\r\n\t\t\t\treturn ;\r\n\t\t\tnotificationMessage.Unread = false;\r\n\t\t\tnotificationMessage.CRUD();\r\n\t\t}\r\n\t\tpublic static void SetReadNotificationMessage(long moId)\r\n\t\t{\r\n\t\t\tvar notificationMessage = (MO_NotificationMessage) MetaObject.LoadById(moId);\r\n\t\t\tnotificationMessage.Unread = false;\r\n\t\t\tnotificationMessage.CRUD();\r\n\t\t}\r\n\t\tpublic static void SendNotification(MetaObject mo)\r\n\t\t{\r\n\t\t\tMO_نوتیفیکشن notif = (MO_نوتیفیکشن) mo;\r\n\t\t\tvar actions = new List<NotificationBaseAction>();\r\n\t\t\tforeach (MetaObject cmd in notif.دستورات)\r\n\t\t\t{\r\n\t\t\t\tMO_دستورنوتیفیکشن cmdNotif = (MO_دستورنوتیفیکشن) cmd;\r\n\t\t\t\tactions.Add(new NotificationBaseAction()\r\n\t\t\t\t\t{\r\n\t\t\t\t\t\tTitle = cmdNotif.عنوان,\r\n\t\t\t\t\tIcon = cmdNotif.آیکن,\r\n\t\t\t\t\tStatus = (ActionButtonStatus) cmdNotif.وضعیت\r\n\t\t\t\t\t});\r\n\t\t\t}\r\n\t\t\tSendMoNotification(notif.شی_مرتبط_MetaObject, \"\", notif.عنوان, notif.محتوا, new []\r\n\t\t\t\t{\r\n\t\t\t\t\tnotif.کاربر\r\n\t\t\t\t}, actions);\r\n\t\t}\r\n\t\tpublic static void SetNotificationViewed(string[] tags)\r\n\t\t{\r\n\t\t\tif (tags.Length<1)\r\n\t\t\t{\r\n\t\t\t\treturn ;\r\n\t\t\t}\r\n\t\t\tvar list = tags.JoinAsText(\",\", x =>\"'\" + x + \"'\");\r\n\t\t\tvar sql = \"update {0} set {1}={2} where {3} in ({4})\".ReplaceParameters\r\n\t\t\t\t(\r\n\t\t\t\t\tMO_NotificationMessage.TypeDef.DbName,\r\n\t\t\t\t\tMO_NotificationMessage.f_Unread.DbName,\r\n\t\t\t\t\t0,\r\n\t\t\t\t\tMO_NotificationMessage.f_Tag.DbName,\r\n\t\t\t\t\tlist\r\n\t\t\t\t);\r\n\t\t\tDbHelper.ExecuteSql(sql, false);\r\n\r\n\t\t}\r\n\t\tpublic static NotificationActionResult ExecuteNotificationAction(string tag, string actionTitle)\r\n\t\t{\r\n\r\n\t\t\tvar notificationMessage = (MO_NotificationMessage) MO_NotificationMessage.TypeDef.SelectFirstObjectBy(MO_NotificationMessage.cf_Tag, tag, new string[]\r\n\t\t\t\t{\r\n\t\t\t\t\tMO_NotificationMessage.cf_IMessage, MO_IMessage.cf_کاربر_گیرنده\r\n\t\t\t\t}, Util.CurrentUserId);\r\n\t\t\tif (notificationMessage == null)\r\n\t\t\t{\r\n\t\t\t\tSplLogger.WriteLine(string.Format(\"ExecuteNotificationAction can not find notification message with tag and user {0}\", tag));\r\n\t\t\t\treturn null;\r\n\t\t\t}\r\n\t\t\tvar message = (MO_IMessage) notificationMessage.IMessage_MetaObject;\r\n\r\n\t\t\tvar mo = notificationMessage.RelatedMo<1 ? null:MetaObject.LoadById(notificationMessage.RelatedMo);\r\n\t\t\tNotificationActionResult result = new NotificationActionResult()\r\n\t\t\t{\r\n\t\t\t\tMo = mo\r\n\t\t\t};\r\n\t\t\tif (actionTitle == \"show\" && notificationMessage.RelatedMo>0)\r\n\t\t\t{\r\n\t\t\t\tresult.ShowFormSetting = new ShowFormSetting()\r\n\t\t\t\t{\r\n\t\t\t\t\tMoId = WebUtil.EncodeId(notificationMessage.RelatedMo),\r\n\t\t\t\t\tViewName = string.IsNullOrEmpty(notificationMessage.RelatedMoNama) ? string.Empty :notificationMessage.RelatedMoNama\r\n\t\t\t\t};\r\n\t\t\t}\r\n\t\t\telse if (!string.IsNullOrEmpty(notificationMessage.Actions))\r\n\t\t\t{\r\n\t\t\t\tvar actions = JsonConvert.DeserializeObject<IList<NotificationActionCommandInfo>>(notificationMessage.Actions);\r\n\t\t\t\tvar dynamicCommand = actions.FirstOrDefault(c =>c.Title == actionTitle);\r\n\t\t\t\tif (dynamicCommand != null)\r\n\t\t\t\t{\r\n\t\t\t\t\t//\tvar methodResult = ReflectionHelper.RunMethod(\"Barsa.Web.Ui.dll\", \"Barsa.Meta.Ui.ExtWeb.Service.CommandService\", \"GetCommandJs\", WebUtil.DecodeId(dynamicCommand.Id), mo);\r\n\t\t\t\t\t//\tstring jsCode = JsonConvert.SerializeObject(methodResult);\r\n\t\t\t\t\tresult.DynamicCommandId = dynamicCommand.Id;\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\telse if (!string.IsNullOrEmpty(notificationMessage.ChoiceList))\r\n\t\t\t{\r\n\t\t\t\tvar actions = JsonConvert.DeserializeObject<IList<NotificationActionWorkflowData>>(notificationMessage.ChoiceList);\r\n\t\t\t\tvar choiceDef = actions.FirstOrDefault(c =>c.Title == actionTitle);\r\n\t\t\t\tif (choiceDef != null)\r\n\t\t\t\t{\r\n\t\t\t\t\tChoiceDefDTO choice = new ChoiceDefDTO()\r\n\t\t\t\t\t{\r\n\t\t\t\t\t\tActivityDefId = WebUtil.DecodeId(choiceDef.ActivityDefId),\r\n\t\t\t\t\t\t ActivityRunId = WebUtil.DecodeId(choiceDef.ActivityRunId),\r\n\t\t\t\t\t\t ChoiceDefId = WebUtil.DecodeId(choiceDef.ChoiceDefId),\r\n\t\t\t\t\t\t Title = choiceDef.Title\r\n\t\t\t\t\t};\r\n\t\t\t\t\tReflectionHelper.RunMethod(\"Barsa.Web.Ui.dll\", \"Barsa.Meta.Ui.ExtWeb.Service.Workflow94Service\", \"ChoiceSelect\", choice, MetaObject.LoadById(notificationMessage.RelatedMo));\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\tnotificationMessage.Unread = false;\r\n\t\t\tnotificationMessage.CRUD();\r\n\t\t\treturn result;\r\n\r\n\t\t}\r\n\t\tpublic static void SendMoNotificationByExpire(MetaObject mo, string relatedMoNama, string title, string content, long[] userIds, IEnumerable<NotificationBaseAction> listOfActions, DateTime expireAt, NotificationAction notificationAction = null, string tag = \"\")\r\n\t\t{\r\n\t\t\tstring uiActions;\r\n\t\t\tvar actions = NotificationHelper.GetCommandsInfo(mo, listOfActions, out uiActions);\r\n\t\t\tMO_NotificationMessage new_notification = null;\r\n\r\n\t\t\tfor (var i = 0; i<userIds.Length; i++)\r\n\t\t\t{\r\n\t\t\t\tvar enablePopup = _isUserEnableNotificationPopup(userIds[i], null);\r\n\t\t\t\tnew_notification = CreateNotificationMessage(new NotificationMessage\r\n\t\t\t\t\t{\r\n\t\t\t\t\t\tRelatedMo = mo,\r\n\t\t\t\t\t\tRelatedMoNama = relatedMoNama,\r\n\t\t\t\t\t\tTitle = title,\r\n\t\t\t\t\t\tContent = content,\r\n\t\t\t\t\t\tStatus = NotificationStatus.Success.EnumToLong(),\r\n\t\t\t\t\t\tActions = actions,\r\n\t\t\t\t\t\tChoiceList = string.Empty,\r\n\t\t\t\t\t\tPriority = NotificationPriority.Low.EnumToLong(),\r\n\t\t\t\t\t\tUiActions = uiActions,\r\n\t\t\t\t\t\tOverflowButtons = true,\r\n\t\t\t\t\t\tSplUser = userIds[i],\r\n\t\t\t\t\t\tExpireAt = expireAt\r\n\t\t\t\t\t}, tag, enablePopup);\r\n\t\t\t}\r\n\t\t\tif (new_notification != null)\r\n\t\t\t{\r\n\t\t\t\tSendPopupNotification(userIds, new_notification, notificationAction);\r\n\t\t\t}\r\n\t\t}\r\n\t\tpublic static void SendMoNotification(MetaObject mo, string relatedMoNama, string title, string content, long[] userIds, IEnumerable<NotificationBaseAction> listOfActions, NotificationAction notificationAction = null, string tag = \"\")\r\n\t\t{\r\n\t\t\tSendMoNotificationByExpire(mo, relatedMoNama, title, content, userIds, listOfActions, DateTime.Now.AddDays(1), notificationAction, tag);\r\n\t\t}\r\n\t\tpublic static void SendWorkflowNotification(MetaObject moRadifCartable, MetaObject mo, long[] userIds, NotificationAction notificationAction)\r\n\t\t{\r\n\t\t\tvar tag = moRadifCartable == null ? Guid.NewGuid().ToString() :moRadifCartable.GetFieldValue<string>(\"Tag\");\r\n\t\t\tWorkflowFormData workflowFormData;\r\n\t\t\tstring uiActions;\r\n\t\t\tint actionCount;\r\n\t\t\tvar choiceList = string.Empty;\r\n\t\t\tif (SessionMgr.UserIdOr0 == 0)\r\n\t\t\t{\r\n\t\t\t\tusing (SessionMgr.ChangeUserId(userIds[0]))\r\n\t\t\t\t{\r\n\t\t\t\t\tchoiceList = NotificationHelper.GetWorkflowChoiceDefsInfo(mo, out workflowFormData, out uiActions, out actionCount);\r\n\t\t\t\t}\r\n\t\t\t}else\r\n\t\t\t{\r\n\t\t\t\tchoiceList = NotificationHelper.GetWorkflowChoiceDefsInfo(mo, out workflowFormData, out uiActions, out actionCount);\r\n\t\t\t}\r\n\t\t\tbool isRemoveFromCartable = notificationAction.ActionType == NotificationActionType.Remove;\r\n\t\t\tif (isRemoveFromCartable)\r\n\t\t\t{\r\n\t\t\t\tchoiceList = string.Empty;\r\n\t\t\t\tuiActions = string.Empty;\r\n\t\t\t\tvar moListOfMessage = MO_NotificationMessage.TypeDef.SelectObjectListBy(\"Tag\", tag);\r\n\r\n\t\t\t\tforeach (MetaObject moMessage in moListOfMessage)\r\n\t\t\t\t{\r\n\r\n\t\t\t\t\t//TODO notify user's message to remove it from zangoleh\r\n\t\t\t\t\tMO_NotificationMessage notificationMessage = moMessage;\r\n\t\t\t\t\tMO_IMessage messageMo = MetaObject.LoadById(notificationMessage.IMessage);\r\n\r\n\t\t\t\t\t//\t\t\t\t\tReflectionHelper.RunMethod(\"Barsa.Web.Ui.dll\", \"Barsa.Meta.Ui.ExtWeb.NotificationManager\", \"PublishMoDelete\", notificationMessage.Object, null, message.کاربر_گیرنده, false);\r\n\t\t\t\t\tmoMessage.Delete();\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\tstring activityDefCaption = workflowFormData == null ? null: workflowFormData.ActivityDef.Caption;\r\n\t\t\tMO_NotificationMessage new_notification = null;\r\n\r\n\t\t\tuserIds = userIds.Distinct().ToArray();\r\n\t\t\tfor (var i = 0; i<userIds.Length; i++)\r\n\t\t\t{\r\n\r\n\t\t\t\tvar enablePopup = _isUserEnableNotificationPopup(userIds[i], moRadifCartable);\r\n\t\t\t\tnew_notification = CreateNotificationMessage(new NotificationMessage\r\n\t\t\t\t\t{\r\n\t\t\t\t\t\tRelatedMo = moRadifCartable,\r\n\t\t\t\t\t\tRelatedMoNama = string.Empty,\r\n\t\t\t\t\t\tTitle = string.Format(\"{0}: {1}\", activityDefCaption, mo.TypeDef.Caption),\r\n\t\t\t\t\t\tContent = notificationAction.ActionType == NotificationActionType.Add ? \"به کارتابل شما اضافه شد.\" : \"از کارتابل شما خارج شد.\",\r\n\t\t\t\t\t\tStatus = NotificationStatus.Success.EnumToLong(),\r\n\t\t\t\t\t\tActions = string.Empty,\r\n\t\t\t\t\t\tChoiceList = choiceList,\r\n\t\t\t\t\t\tUiActions = uiActions,\r\n\t\t\t\t\t\tPriority = NotificationPriority.High.EnumToLong(),\r\n\t\t\t\t\t\tHideShowButton = isRemoveFromCartable ? true:false,\r\n\t\t\t\t\t\tHideDeleteButton = false,\r\n\t\t\t\t\t\tOverflowButtons = actionCount> 2 && isRemoveFromCartable? true:false,\r\n\t\t\t\t\t\tSubject = activityDefCaption,\r\n\t\t\t\t\t\tSplUser = userIds[i]\r\n\t\t\t\t\t}, tag, enablePopup);\r\n\t\t\t}\r\n\r\n\t\t\tif (new_notification != null)\r\n\t\t\t{\r\n\r\n\t\t\t\tSendPopupNotification(userIds, new_notification, notificationAction);\r\n\t\t\t}\r\n\t\t}\r\n\r\n#region Test\t\t\r\n\t\tpublic static void TestSendNotification(MetaObject mo) // Test\r\n\t\t{\r\n\r\n\t\t\tif (mo.IsNew)\r\n\t\t\t\tmo.CRUD();\r\n\t\t\tTest1_Notification(mo);// simple mo\r\n\t\t\t//Test2_Notification();// mo in workflow\t\r\n\t\t}\r\n\r\n\t\tprivate static void Test2_Notification()\r\n\t\t{\r\n\t\t\tvar mo = MetaObject.LoadById(7097025700000000544);\r\n\t\t\tSendWorkflowNotification(null, mo, new []\r\n\t\t\t\t{\r\n\t\t\t\t\tSessionMgr.UserId\r\n\t\t\t\t}, null);\r\n\t\t}\r\n\t\tprivate static void Test1_Notification(MetaObject mo)\r\n\t\t{\r\n\t\t\tMO_SenderDemo senderDemo = mo;\r\n\t\t\tSendMoNotification(mo, \"نمای 1\", senderDemo.Title, senderDemo.Content, new []\r\n\t\t\t\t{\r\n\t\t\t\t\tsenderDemo.User\r\n\t\t\t\t}, new List<NotificationBaseAction>()\r\n\t\t\t\t{\r\n\t\t\t\t\tnew NotificationBaseAction()\r\n\t\t\t\t\t{\r\n\t\t\t\t\t\tTitle = \"تایید\",\r\n\t\t\t\t\t\tIcon = \"accept\",\r\n\t\t\t\t\t\tStatus = ActionButtonStatus.Ghost\r\n\t\t\t\t\t},\r\n\t\t\t\tnew NotificationBaseAction()\r\n\t\t\t\t\t{\r\n\t\t\t\t\t\tTitle = \"رد\",\r\n\t\t\t\t\t\tIcon = \"decline\",\r\n\t\t\t\t\t\tStatus = ActionButtonStatus.Negative\r\n\t\t\t\t\t}\r\n\t\t\t\t});\r\n\t\t}\r\n\t\tpublic static M